# AURORA Configuration
# Copy to .env.local for local development

# OpenAI API Key (for future LLM integration)
# OPENAI_API_KEY=sk-...

# Data storage directory
AURORA_DATA_DIR=.aurora-data

# Optional Anthropic-compatible API base URL
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Demo login accepts any valid email; the default password is isb666.
# Set a different password for a non-demo deployment.
# AURORA_LOGIN_PASSWORD=change-this-password

# Set a long, random secret for session signing outside local demos.
# AURORA_SESSION_SECRET=replace-with-a-long-random-secret
